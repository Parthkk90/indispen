generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IndexerState {
  id        String @id
  lastBlock BigInt
}

/// Every protocol event the indexer understands (raw, decoded args in `data`).
model ChainEvent {
  id          String   @id // txHash:logIndex
  kind        String
  address     String
  blockNumber BigInt
  timestamp   DateTime
  txHash      String
  indexId     Int?
  actor       String?
  data        Json

  @@index([kind, blockNumber])
  @@index([actor])
}

model NavPoint {
  id          String   @id // txHash:logIndex
  indexId     Int
  navPerShare String
  totalNav    String
  supply      String
  epoch       Int
  blockNumber BigInt
  timestamp   DateTime
  txHash      String

  @@index([indexId, blockNumber])
}

/// One executed swap through the AquaIndex router (Aqua Pulled = tokenOut, Pushed = tokenIn).
model Trade {
  id           String   @id // txHash:strategyHash
  txHash       String
  blockNumber  BigInt
  timestamp    DateTime
  maker        String
  strategyHash String
  tokenIn      String
  tokenOut     String
  amountIn     String
  amountOut    String

  @@index([strategyHash])
  @@index([maker])
}

/// Strategies shipped to Aqua with the AquaIndex router as app.
model Strategy {
  hash        String   @id
  maker       String
  orderData   String // abi.encode(order) as shipped
  shippedAt   DateTime
  shippedTx   String
  blockNumber BigInt
  docked      Boolean  @default(false)
  dockedTx    String?

  @@index([maker])
}
